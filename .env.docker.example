# Copy this file to .env.docker and fill in production values.
# Do not commit .env.docker or expose these values in screenshots/logs.

SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=your-domain.example,www.your-domain.example,127.0.0.1,localhost
ACME_EMAIL=admin@example.com

DB_ENGINE=django.db.backends.postgresql
DB_NAME=zdblog
DB_USER=zdblog
DB_PASSWORD=replace-with-a-strong-database-password

# Use a strong password. Leave blank only if Redis is isolated on the Docker network.
REDIS_PASSWORD=replace-with-a-strong-redis-password

# Existing DeepSeek-compatible chat provider settings.
LLM_MODEL=deepseek
DEEPSEEK_API_KEY=replace-with-your-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_LLM_MODEL=deepseek-chat
TEMPERATURE=0.7
MAX_TOKENS=4096
VERBOSE=false

# Optional: enable the project's web-search tool if your provider is configured.
SEARCH_URL=
SEARCH_API_KEY=

# Optional SMTP settings, if account verification/email delivery is needed.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.qq.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=

RAG_ENABLED=true
RAG_EMBED_PROVIDER=openai
RAG_EMBED_BASE_URL=https://your-workspace-id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
RAG_EMBED_API_KEY=replace-with-your-dashscope-api-key
RAG_EMBED_MODEL=qwen3.7-text-embedding-flash
RAG_EMBED_DIM=1024
RAG_EMBED_SEND_DIMENSIONS=true

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
